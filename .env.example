# Copie para .env e preencha. O .env nunca vai para o git.
POSTGRES_USER=treinos
POSTGRES_PASSWORD=           # obrigatório: gerar uma senha
TREINOS_JWT_SEGREDO=         # obrigatório: openssl rand -base64 48
TREINOS_LOGIN_SAL=           # obrigatório: sal do contador de login (não guarda e-mail nem IP em claro): openssl rand -base64 48
TREINOS_MFA_CHAVES=          # opcional, mas sem elas o treinador não ativa a verificação em duas etapas: chaves AES-256, formato id:base64 com 32 bytes (openssl rand -base64 32)
TREINOS_MFA_CHAVE_ATIVA=     # id da chave acima usada para cifrar segredos novos (ex.: k1)
MONITORAMENTO_TOKEN=         # opcional: 32 a 128 caracteres [A-Za-z0-9_-] (openssl rand -hex 32). Vazio = coleta de métricas fechada
# Demonstração local (desligada por padrão). Para ligar, descomente as três linhas abaixo:
# SPRING_PROFILES_ACTIVE=docker,demo
# COMPOSE_PROFILES=demo       # sobe também o serviço `importacao` (conteúdo do Saraiva)
# DEMO_SENHA=                 # obrigatório com o perfil demo: senha das 4 contas de demonstração (mín. 8 caracteres)
CORS_ALLOWED_ORIGINS=http://localhost:8081
APP_URL=http://localhost:8088
REFRESH_COOKIE_SECURE=false  # só local por IP da rede (http). Em produção: true.
REFRESH_COOKIE_PATH=/api/auth
# Integração com a Central (docs/integracao-central.md). Tudo opcional; sem TREINOS_INTEGRACAO_ATIVA=true nada muda.
# Os segredos são Base64 de pelo menos 32 bytes (openssl rand -base64 48) e NUNCA vão para o git.
TREINOS_INTEGRACAO_ATIVA=false
TREINOS_INTEGRACAO_CHAVES_ENTRADA=      # id:segredoBase64 com que a Central assina para o Saraiva
TREINOS_INTEGRACAO_CHAVE_SAIDA_ID=      # id da chave com que o Saraiva assina para a Central
TREINOS_INTEGRACAO_CHAVE_SAIDA_SEGREDO=
TREINOS_INTEGRACAO_CENTRAL_URL=         # https://api-central.exemplo.com.br (só a base, sem /integracao)
TREINOS_INTEGRACAO_PRODUTO=TREINOS
TREINOS_INTEGRACAO_TOLERANCIA_HORAS=72
TREINOS_INTEGRACAO_BLOQUEIO_ATIVO=false # true: consultoria suspensa pela Central (ou sem confirmação além da tolerância) não entra
TREINOS_PLANO_APLICAR=false # true: limites e funcionalidades do plano da Central passam a barrar (só consultoria com direitos; ligar depois de configurar o produto na Central)
TREINOS_TURNSTILE_HABILITADO=false # true: cadastro de treinador, login e esqueci a senha exigem o Turnstile (falta chave ou segredo = a API não sobe)
TREINOS_TURNSTILE_SITE_KEY= # chave pública do widget (vai ao app por GET /publico/configuracao)
TREINOS_TURNSTILE_SEGREDO= # segredo do widget: só aqui no servidor, nunca no git (na VPS, gravar-segredo.sh)
# E-mail de acesso (esqueci a senha e convite de equipe). Desligado por padrão (provedor "log": só registra que houve envio, nunca o link).
# Em produção: HABILITADO=true, PROVEDOR=resend, REMETENTE no formato `Nome <endereço>` de um domínio verificado no Resend (Consultoria <nao-responda@exemplo.com.br>)
# e a chave "Sending access" restrita a esse domínio. A chave NUNCA vai para o git. Sem ela o app não sobe com o provedor resend.
TREINOS_EMAIL_HABILITADO=false
TREINOS_EMAIL_PROVEDOR=log
TREINOS_EMAIL_REMETENTE=
TREINOS_EMAIL_NOME_APP=Overtraining
TREINOS_EMAIL_RESEND_API_KEY=
# Fotos da atualização (docs/fotos.md e AGENTS.md, item Fotos da atualização). Desligadas por padrão: a pergunta FOTOS segue sem envio e o app diz "Fotos ainda não disponíveis".
# Ligadas (HABILITADO=true) a API só sobe com ENDPOINT, BUCKET, CHAVE e SEGREDO. Em produção é o R2 da Cloudflare (bucket privado,
# token Object Read & Write só nesse bucket); os valores NUNCA vão para o git. Local: `docker compose --profile fotos up -d` com o MinIO abaixo.
TREINOS_FOTOS_HABILITADO=false
TREINOS_FOTOS_ENDPOINT=      # R2: https://<ID-DA-CONTA>.r2.cloudflarestorage.com (sem o nome do bucket); MinIO local: http://minio:9000
TREINOS_FOTOS_BUCKET=        # consultoria-fotos
TREINOS_FOTOS_CHAVE=         # Access Key ID do token
TREINOS_FOTOS_SEGREDO=       # Secret Access Key do token
TREINOS_FOTOS_REGIAO=auto    # R2 usa "auto"
# Push do Expo (aviso no celular quando um compromisso muda; docs/planos/push-do-expo.md). Desligado por padrão: as rotas do token dão 503 e o app não pede permissão.
# O token de acesso do Expo (enhanced security) é opcional e NUNCA tem valor aqui nem no git (na VPS, gravar-segredo.sh); vazio = envia sem Authorization.
TREINOS_PUSH_HABILITADO=false
TREINOS_PUSH_EXPO_URL=       # vazio = https://exp.host/--/api/v2/push/send
TREINOS_PUSH_EXPO_TOKEN=
TREINOS_PUSH_ENVIO_AGENDADO=true   # false só nos testes
# Avisos pelo WhatsApp oficial da Meta (lembrete de cobrança e compromisso, por modelo aprovado; o aluno autoriza). Desligado por padrão: as rotas dão 503 WHATSAPP_INDISPONIVEL e a API sobe sem as variáveis abaixo.
# Ligado, a subida exige as quatro seguintes, que NUNCA têm valor aqui nem no git (na VPS, gravar-segredo.sh). O token de acesso de cada consultoria fica cifrado no banco com as chaves.
TREINOS_WHATSAPP_HABILITADO=false
TREINOS_WHATSAPP_CHAVES=             # chaves AES-256 do token de acesso de cada consultoria: id:base64 com 32 bytes (openssl rand -base64 32), separadas por vírgula
TREINOS_WHATSAPP_CHAVE_ATIVA=        # id da chave que cifra o que é gravado agora
TREINOS_WHATSAPP_META_APP_SECRET=    # segredo do aplicativo da Meta (assina o webhook)
TREINOS_WHATSAPP_META_VERIFY_TOKEN=  # senha que a Meta devolve ao cadastrar o webhook
TREINOS_WHATSAPP_META_URL=           # vazio = https://graph.facebook.com (só muda em teste)
TREINOS_RETORNO_HABILITADO=false   # true liga o retorno imediato do aluno (Concluir treino, recordes, treino ao vivo, "Bom trabalho!", Visto e o mapa de treinos)
TREINOS_PAGAMENTOS_HABILITADO=false   # true liga planos comerciais, cobranças e painel financeiro do treinador
# Contrato digital do aluno (modelos, aceite com evidências e prazo para assinar): desligado por padrão.
TREINOS_CONTRATOS_HABILITADO=false
# Vitrine da consultoria (itens que o treinador mostra ao aluno, sem pagamento): desligada por padrão.
TREINOS_VITRINE_HABILITADA=false
# Página pública da loja (só leitura; só vale com a vitrine ligada): desligada por padrão.
TREINOS_LOJA_HABILITADA=false
# Lista pública de lojas entre consultorias (marketplace; só vale com a vitrine e a loja ligadas): desligada por padrão.
TREINOS_MARKETPLACE_HABILITADO=false
# Ciclo menstrual, unidade da carga (libras) e importação assistida: desligados por padrão.
TREINOS_CICLO_HABILITADO=false
TREINOS_UNIDADE_CARGA_HABILITADA=false
TREINOS_MIGRACAO_ASSISTIDA_HABILITADA=false
# Recebimento online pela InfinitePay (o aluno paga por um link na conta do treinador). Desligado por padrão; ligado, a API só sobe
# com as três variáveis abaixo preenchidas. As chaves NUNCA vão para o git (na VPS, gravar-segredo.sh).
TREINOS_PAGAMENTOS_INFINITEPAY_HABILITADO=false
TREINOS_PAGAMENTOS_CHAVES=             # chaves AES-256 da API Key do treinador: id:base64 com 32 bytes (openssl rand -base64 32), separadas por vírgula
TREINOS_PAGAMENTOS_CHAVE_ATIVA=        # id da chave acima que cifra o que é gravado agora (ex.: k1); trocar a chave = acrescentar uma nova e ativá-la, sem tirar a antiga
TREINOS_PAGAMENTOS_URL_PUBLICA=        # https://api.exemplo.com.br (a URL pública desta API; a InfinitePay chama {url}/publico/pagamentos/infinitepay/<token>)
# Kiwify automática (a Kiwify cobra a assinatura do aluno e avisa por webhook assinado). Desligada por padrão; ligada, a API só sobe com
# as três variáveis TREINOS_PAGAMENTOS_CHAVES, _CHAVE_ATIVA e _URL_PUBLICA acima (a Kiwify chama {url}/publico/pagamentos/kiwify/<token>).
TREINOS_PAGAMENTOS_KIWIFY_HABILITADO=false
TREINOS_PAGAMENTOS_KIWIFY_URL_API=     # vazio = https://public-api.kiwify.com (só mude em teste; https obrigatório)
TREINOS_PAGAMENTOS_KIWIFY_CONCILIACAO_ATIVA=   # vazio = ligada; false só nos testes
# Botão "Pagar" no celular (só UI; GET /eu traz pagarNoIos e pagarNoAndroid). Desligados por padrão, até o dono decidir pelas regras das lojas.
TREINOS_PAGAMENTOS_PAGAR_NO_IOS=false
TREINOS_PAGAMENTOS_PAGAR_NO_ANDROID=false
# Rotina diária (4h15 de Brasília) que gera a mensalidade de todo mês. Vazio = ligada; false só nos testes (eles chamam a rotina à mão).
TREINOS_PAGAMENTOS_GERACAO_AGENDADA=
MINIO_USUARIO=             # só com o perfil fotos do compose (MinIO local): usuário de admin do bucket, igual a TREINOS_FOTOS_CHAVE
MINIO_SENHA=                 # só com o perfil fotos: senha, igual a TREINOS_FOTOS_SEGREDO
# Importação assistida (só nomes; sem valor). Provedor padrão = regras (local, nada sai do servidor).
TREINOS_IA_PROVEDOR=regras
# LGPD, fail-closed: false (padrão) = nada do arquivo vai a Gemini/Claude, mesmo com provedor e chave. Só ligar com decisão registrada.
TREINOS_IA_ENVIAR_DADOS_AO_PROVEDOR=false
TREINOS_IA_GEMINI_API_KEY=
TREINOS_IA_CLAUDE_API_KEY=
TREINOS_IMPORTACAO_ASSISTIDA_RETENCAO_AGENDADA=true   # false só nos testes
