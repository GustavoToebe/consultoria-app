# Copie para .env e preencha. O .env nunca vai para o git.
POSTGRES_USER=treinos
POSTGRES_PASSWORD=           # obrigatório: gerar uma senha
TREINOS_JWT_SEGREDO=         # obrigatório: openssl rand -base64 48
TREINOS_LOGIN_SAL=           # obrigatório: sal do contador de login (não guarda e-mail nem IP em claro): openssl rand -base64 48
TREINOS_MFA_CHAVES=          # opcional, mas sem elas o treinador não ativa a verificação em duas etapas: chaves AES-256, formato id:base64 com 32 bytes (openssl rand -base64 32)
TREINOS_MFA_CHAVE_ATIVA=     # id da chave acima usada para cifrar segredos novos (ex.: k1)
MONITORAMENTO_TOKEN=         # opcional: 32 a 128 caracteres [A-Za-z0-9_-] (openssl rand -hex 32). Vazio = coleta de métricas fechada
DEMO_SENHA=                  # obrigatório no profile demo: senha das 4 contas de demonstração (mín. 8 caracteres)
CORS_ALLOWED_ORIGINS=http://localhost:8081
APP_URL=http://localhost:8088
REFRESH_COOKIE_SECURE=false  # só local por IP da rede (http). Em produção: true.
REFRESH_COOKIE_PATH=/api/auth
# Integração com a Central (docs/integracao-central.md). Tudo opcional; sem TREINOS_INTEGRACAO_ATIVA=true nada muda.
# Os segredos são Base64 de pelo menos 32 bytes (openssl rand -base64 48) e NUNCA vão para o git.
TREINOS_INTEGRACAO_ATIVA=false
TREINOS_INTEGRACAO_CHAVES_ENTRADA=      # id:segredoBase64 com que a Central assina para o Saraiva
TREINOS_INTEGRACAO_CHAVE_SAIDA_ID=      # id da chave com que o Saraiva assina para a Central
TREINOS_INTEGRACAO_CHAVE_SAIDA_SEGREDO=
TREINOS_INTEGRACAO_CENTRAL_URL=         # https://api-central.exemplo.com.br (só a base, sem /integracao)
TREINOS_INTEGRACAO_PRODUTO=TREINOS
TREINOS_INTEGRACAO_TOLERANCIA_HORAS=72
TREINOS_INTEGRACAO_BLOQUEIO_ATIVO=false # true: consultoria suspensa pela Central (ou sem confirmação além da tolerância) não entra
