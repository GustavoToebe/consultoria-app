# Copie para .env e preencha. O .env nunca vai para o git.
POSTGRES_USER=treinos
POSTGRES_PASSWORD=           # obrigatório: gerar uma senha
TREINOS_JWT_SEGREDO=         # obrigatório: openssl rand -base64 48
TREINOS_LOGIN_SAL=           # obrigatório: sal do contador de login (não guarda e-mail nem IP em claro): openssl rand -base64 48
TREINOS_MFA_CHAVES=          # opcional, mas sem elas o treinador não ativa a verificação em duas etapas: chaves AES-256, formato id:base64 com 32 bytes (openssl rand -base64 32)
TREINOS_MFA_CHAVE_ATIVA=     # id da chave acima usada para cifrar segredos novos (ex.: k1)
MONITORAMENTO_TOKEN=         # opcional: 32 a 128 caracteres [A-Za-z0-9_-] (openssl rand -hex 32). Vazio = coleta de métricas fechada
# Demonstração local (desligada por padrão). Para ligar, descomente as três linhas abaixo:
# SPRING_PROFILES_ACTIVE=docker,demo
# COMPOSE_PROFILES=demo       # sobe também o serviço `importacao` (conteúdo do Saraiva)
# DEMO_SENHA=                 # obrigatório com o perfil demo: senha das 4 contas de demonstração (mín. 8 caracteres)
CORS_ALLOWED_ORIGINS=http://localhost:8081
APP_URL=http://localhost:8088
REFRESH_COOKIE_SECURE=false  # só local por IP da rede (http). Em produção: true.
REFRESH_COOKIE_PATH=/api/auth
# Integração com a Central (docs/integracao-central.md). Tudo opcional; sem TREINOS_INTEGRACAO_ATIVA=true nada muda.
# Os segredos são Base64 de pelo menos 32 bytes (openssl rand -base64 48) e NUNCA vão para o git.
TREINOS_INTEGRACAO_ATIVA=false
TREINOS_INTEGRACAO_CHAVES_ENTRADA=      # id:segredoBase64 com que a Central assina para o Saraiva
TREINOS_INTEGRACAO_CHAVE_SAIDA_ID=      # id da chave com que o Saraiva assina para a Central
TREINOS_INTEGRACAO_CHAVE_SAIDA_SEGREDO=
TREINOS_INTEGRACAO_CENTRAL_URL=         # https://api-central.exemplo.com.br (só a base, sem /integracao)
TREINOS_INTEGRACAO_PRODUTO=TREINOS
TREINOS_INTEGRACAO_TOLERANCIA_HORAS=72
TREINOS_INTEGRACAO_BLOQUEIO_ATIVO=false # true: consultoria suspensa pela Central (ou sem confirmação além da tolerância) não entra
TREINOS_PLANO_APLICAR=false # true: limites e funcionalidades do plano da Central passam a barrar (só consultoria com direitos; ligar depois de configurar o produto na Central)
TREINOS_TURNSTILE_HABILITADO=false # true: cadastro de treinador, login e esqueci a senha exigem o Turnstile (falta chave ou segredo = a API não sobe)
TREINOS_TURNSTILE_SITE_KEY= # chave pública do widget (vai ao app por GET /publico/configuracao)
TREINOS_TURNSTILE_SEGREDO= # segredo do widget: só aqui no servidor, nunca no git (na VPS, gravar-segredo.sh)
# E-mail de acesso (esqueci a senha e convite de equipe). Desligado por padrão (provedor "log": só registra que houve envio, nunca o link).
# Em produção: HABILITADO=true, PROVEDOR=resend, REMETENTE no formato `Nome <endereço>` de um domínio verificado no Resend (Consultoria <nao-responda@exemplo.com.br>)
# e a chave "Sending access" restrita a esse domínio. A chave NUNCA vai para o git. Sem ela o app não sobe com o provedor resend.
TREINOS_EMAIL_HABILITADO=false
TREINOS_EMAIL_PROVEDOR=log
TREINOS_EMAIL_REMETENTE=
TREINOS_EMAIL_NOME_APP=Consultoria
TREINOS_EMAIL_RESEND_API_KEY=
# Fotos da atualização (docs/fotos.md e AGENTS.md, item Fotos da atualização). Desligadas por padrão: a pergunta FOTOS segue sem envio e o app diz "Fotos ainda não disponíveis".
# Ligadas (HABILITADO=true) a API só sobe com ENDPOINT, BUCKET, CHAVE e SEGREDO. Em produção é o R2 da Cloudflare (bucket privado,
# token Object Read & Write só nesse bucket); os valores NUNCA vão para o git. Local: `docker compose --profile fotos up -d` com o MinIO abaixo.
TREINOS_FOTOS_HABILITADO=false
TREINOS_FOTOS_ENDPOINT=      # R2: https://<ID-DA-CONTA>.r2.cloudflarestorage.com (sem o nome do bucket); MinIO local: http://minio:9000
TREINOS_FOTOS_BUCKET=        # consultoria-fotos
TREINOS_FOTOS_CHAVE=         # Access Key ID do token
TREINOS_FOTOS_SEGREDO=       # Secret Access Key do token
TREINOS_FOTOS_REGIAO=auto    # R2 usa "auto"
TREINOS_PAGAMENTOS_HABILITADO=false   # true liga planos comerciais, cobranças e painel financeiro do treinador
MINIO_USUARIO=               # só com o perfil fotos do compose (MinIO local): usuário de admin do bucket, igual a TREINOS_FOTOS_CHAVE
MINIO_SENHA=                 # só com o perfil fotos: senha, igual a TREINOS_FOTOS_SEGREDO
